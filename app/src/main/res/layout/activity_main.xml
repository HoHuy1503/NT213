<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <Button
        android:id="@+id/btnCheckRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kiểm tra Root" />

    <Button
        android:id="@+id/btnTestNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="HTTPS · pin hợp lệ" />

    <Button
        android:id="@+id/btnWrongPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đối chứng · pin OkHttp sai" />
    <Button
        android:id="@+id/btnOpenWebView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="WebView · bản lab" />

    <Button
        android:id="@+id/btnSafeWebView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WebView · bản phòng thủ" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Trạng thái: Sẵn sàng" />
</LinearLayout>

